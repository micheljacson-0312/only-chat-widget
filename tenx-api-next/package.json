    "@types/react-dom": "^19",
    "@types/supertest": "^6.0.2",
    "eslint": "^9",
    "eslint-config-next": "^15.1.0",
    "jest": "^29.7.0",
    "jest-util": "^30.4.1",
    "prisma": "^6.19.3",
    "supertest": "^6.3.4",
    "tailwindcss": "^4",
    "ts-jest": "^29.1.2",
    "ts-node": "^10.9.2",
    "typescript": "^5",
    "wrangler": "^4.95.0"
